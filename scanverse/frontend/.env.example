# Copy to .env for local dev (optional), or set in the hosting platform's UI.

# Where the backend lives.
# - Leave unset (or /api/v1) when nginx/Vite proxies /api and /media
#   (Docker Compose and local dev with VITE_API_PROXY_TARGET).
# - On Vercel: set to the FULL backend URL, e.g.
#   VITE_API_BASE_URL=https://scanverse-api.onrender.com/api/v1
#   The backend must allow your Vercel origin in CORS_ORIGINS.
VITE_API_BASE_URL=

# Local dev only: where the Vite dev server proxies /api and /media.
# Default http://backend:8000 (Docker). Use http://localhost:8000 when the
# backend runs on the host.
VITE_API_PROXY_TARGET=http://localhost:8000
